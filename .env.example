# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Live-state secrets (two separate paths) ───────────────────
# Machine path: OBS / cron POSTs /api/stream/status with this in the
# `x-stream-token` header.
STREAM_STATUS_TOKEN=
# Human path: typed into the /admin passcode field.
ADMIN_PASSCODE=
# Encrypts the /admin session cookie (iron-session). Must be >= 32 characters.
ADMIN_SESSION_SECRET=

# ── Email ─────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Site ──────────────────────────────────────────────────────
# Bare host, no protocol. The Twitch player embed needs the exact host.
NEXT_PUBLIC_SITE_DOMAIN=localhost
