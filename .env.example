# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=       # "Project URL" (https://<ref>.supabase.co)
# Use the legacy "anon" key (a JWT), NOT the sb_publishable_ key — Realtime
# postgres_changes silently drops events for non-JWT keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # "service_role" secret — server only, never NEXT_PUBLIC_

# ── Live-state secrets (two separate paths) ───────────────────
# Machine path: OBS / cron POSTs /api/stream/status with this in the
# `x-stream-token` header.
STREAM_STATUS_TOKEN=
# Human path: typed into the /admin passcode field.
ADMIN_PASSCODE=
# Encrypts the /admin session cookie (iron-session). Must be >= 32 characters.
ADMIN_SESSION_SECRET=

# ── Email ─────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender, e.g. "SOL_DNB <hello@sol-dnb.com>". Falls back to
# onboarding@resend.dev (test mode — only delivers to the Resend account owner).
RESEND_FROM=
# Resend Audience id — newsletter signups are added to this list. Optional;
# without it the signup just sends the confirmation email.
RESEND_AUDIENCE_ID=
# Where replies to the confirmation email go. Optional — set to a real inbox
# (a mailbox or a forwarder) so unsubscribe-by-reply / questions aren't lost.
RESEND_REPLY_TO=

# ── Discord ───────────────────────────────────────────────────
# Optional. A channel webhook URL (Server Settings → Integrations → Webhooks).
# When set, each new track request pings that channel. Unset = silently skipped.
DISCORD_WEBHOOK_URL=

# ── Site ──────────────────────────────────────────────────────
# Optional. Canonical origin for metadata / robots / sitemap (no trailing
# slash). When unset, dev uses http://localhost:3000 and every deployed build
# falls back to the hardcoded PRODUCTION_URL in src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL=
# Optional / unused. Bare host, no protocol. The Twitch embed derives its
# parent from window.location.hostname, so this is not required.
NEXT_PUBLIC_SITE_DOMAIN=localhost
