# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev helpers
/screenshot.mjs
/*.png
/_*.mjs

# stray nested scaffold from a parallel effort
/sol-portal/

# typescript
*.tsbuildinfo
next-env.d.ts

# local source drop for the profile photo (served copy lives in public/)
/SolProfileImage/

# python bytecode (OBS script dev)
__pycache__/
*.pyc
